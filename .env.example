# ============================================================
# CRABMAS — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# --- Passwords ---
# The magic word James must type to enter the site
NEXT_PUBLIC_ENTRY_PASSWORD=I love copper

# Admin password (for editing cards, never expose to client)
ADMIN_PASSWORD=your-secret-admin-password

# JWT secret for session tokens (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here

# --- Firebase (Client SDK — safe to expose) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# --- Firebase Admin SDK (Server-side only — NEVER expose) ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
